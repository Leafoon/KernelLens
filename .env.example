# KernelLens Configuration
# Variables with KERNELLENS_ prefix take precedence over OPENAI_ prefix.

# Required: API key
KERNELLENS_API_KEY=replace-me
# OPENAI_API_KEY=replace-me  # fallback

# Required: Model identifier
KERNELLENS_MODEL=gpt-4o
# OPENAI_MODEL=gpt-4o  # fallback

# Optional: API base URL (default: https://api.openai.com/v1)
# KERNELLENS_BASE_URL=https://your-provider.example/v1
# OPENAI_BASE_URL=https://your-provider.example/v1  # fallback

# Optional: Context window override (default: auto from model limits table)
# KERNELLENS_CONTEXT_WINDOW=128000

# Optional: Max output tokens (default: 4096)
# KERNELLENS_MAX_OUTPUT_TOKENS=4096

# Optional: Max decisions per run (default: 30)
# KERNELLENS_MAX_DECISIONS=30

# Optional: Working directory
# KERNELLENS_WORKSPACE=.

# Optional: Log level (debug, info, warn, error)
# KERNELLENS_LOG_LEVEL=info
