# Literal dotenv values; never put actual credentials in Git.
base_url=https://your-provider.example/v1
model=your-model-id
api_key=replace-me

# native function calling, or structured action JSON for compatible APIs
KERNELLENS_TOOL_MODE=native
KERNELLENS_MAX_DECISIONS=20
KERNELLENS_TIMEOUT=60
KERNELLENS_MAX_RUN_SECONDS=300
KERNELLENS_MAX_OUTPUT_TOKENS=4096
KERNELLENS_MAX_TOTAL_TOKENS=60000
KERNELLENS_CONTEXT_CHARS=48000
KERNELLENS_MAX_RETRIES=2

# Optional default execution GPU. Leave unset to ask before generating/optimizing.
# This is the target server's GPU, not automatically the development computer.
# KERNELLENS_GPU="NVIDIA A100"

# Bundled knowledge loads automatically. Override only for a custom delivery.
# KERNELLENS_KNOWLEDGE_DIR=/absolute/path/to/custom/knowledge
# Set an empty value to disable RAG, or pass --no-knowledge.
