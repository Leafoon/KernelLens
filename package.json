{
  "name": "kernellens",
  "version": "0.2.0",
  "description": "An evidence-grounded AI agent for developing and optimizing TileLang GPU kernels.",
  "type": "module",
  "bin": {
    "kernellens": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/",
    "format": "biome format --write src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "keywords": [
    "gpu",
    "kernel",
    "tilelang",
    "gemm",
    "ai-agent",
    "llm",
    "terminal",
    "cli"
  ],
  "author": "Liang Ye",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "dotenv": "^16.5.0",
    "ink": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.0.0",
    "react": "^18.3.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
